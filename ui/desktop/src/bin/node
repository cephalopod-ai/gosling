#!/bin/bash

# Enable strict mode to exit on errors and unset variables
set -euo pipefail

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Source the common setup script
source "${SCRIPT_DIR}/node-setup-common.sh"

# Final step: Execute node with passed arguments, propagating its exit status
# so a failed MCP server surfaces as an error instead of a clean EOF.
log "Executing 'node' command with arguments: ${*}"
STATUS=0
node "${@}" || STATUS=$?
if [ "${STATUS}" -ne 0 ]; then
    log "'node' exited with status ${STATUS} for arguments: ${*}"
fi
exit "${STATUS}"
